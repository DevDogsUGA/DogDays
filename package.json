{
  "name": "dogdays",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "devtools": "pnpm --config.ignore-scripts=true dlx @devdogsuga/devtools@next",
    "codegen": "SKIP_ENV_VALIDATION=1 vinext typegen && tsx scripts/brand-assets.ts",
    "prebuild": "pnpm run codegen",
    "build": "vinext build",
    "predev": "pnpm run codegen",
    "dev": "vinext dev",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "pnpm run build && pnpm run start",
    "prelint": "pnpm run codegen",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "pretypecheck": "pnpm run codegen",
    "typecheck": "tsc --noEmit --pretty false && tsc -p cloudflare/tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache --ignore-path .gitignore --ignore-path .prettierignore",
    "types:cf": "wrangler types cloudflare-env.d.ts --env production --env-interface CloudflareEnv",
    "types:cf:check": "wrangler types cloudflare-env.d.ts --env production --env-interface CloudflareEnv --check"
  },
  "dependencies": {
    "@devdogsuga/sdk": "0.0.1-next.526",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@sentry/cloudflare": "10.75.1",
    "@sentry/nextjs": "10.75.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@vinext/cloudflare": "1.0.1",
    "date-fns": "^4.4.0",
    "match-sorter": "^8.3.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@devdogsuga/config": "0.1.4-next.526",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.3"
  }
}
